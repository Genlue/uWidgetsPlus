<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Batteries.ViewModels"
             x:Class="Batteries.Views.BatteriesView"
             x:DataType="vm:BatteriesViewModel">

    <UserControl.Styles>
        <Style Selector="Border.device-ring-card">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="2" />
        </Style>
        <Style Selector="Border.device-bar-card">
            <Setter Property="Background" Value="#10808080" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
    </UserControl.Styles>

    <Panel Margin="0">
        <!-- 2x2 Small Layout: 2x2 Quad Mini Rings (or 1 Big Ring if single device) -->
        <Grid x:Name="SmallLayout" Margin="2,0,2,0">
            <!-- Quad Rings (Multiple devices) -->
            <ItemsControl x:Name="QuadRingsControl" ItemsSource="{Binding Devices}"
                          VerticalAlignment="Center" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" Rows="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:BatteryDeviceItem">
                        <Border Classes="device-ring-card" Margin="4,3">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                                <!-- Ring Gauge -->
                                <Viewbox Width="44" Height="44" Stretch="Uniform">
                                    <Canvas Width="110" Height="110">
                                        <!-- Track -->
                                        <Path StrokeThickness="9" Opacity="0.18" Stroke="{Binding StatusBrush}">
                                            <Path.Data>
                                                <EllipseGeometry Center="55,55" RadiusX="48" RadiusY="48" />
                                            </Path.Data>
                                        </Path>
                                        <!-- Active Arc -->
                                        <Path StrokeThickness="9" StrokeDashArray="30.16,30.16" StrokeLineCap="Round"
                                              StrokeDashOffset="{Binding StrokeDashOffset}"
                                              Stroke="{Binding StatusBrush}"
                                              RenderTransformOrigin="55,55">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="-90" />
                                            </Path.RenderTransform>
                                            <Path.Data>
                                                <EllipseGeometry Center="55,55" RadiusX="48" RadiusY="48" />
                                            </Path.Data>
                                        </Path>
                                        <!-- Center Icon -->
                                        <PathIcon Data="{Binding IconData}" Width="28" Height="28"
                                                  Canvas.Left="41" Canvas.Top="41"
                                                  Foreground="{Binding StatusBrush}" Opacity="0.95" />
                                        <!-- Charging Bolt Badge -->
                                        <TextBlock Text="⚡" FontSize="18" Canvas.Left="72" Canvas.Top="6"
                                                   Foreground="#34C759" IsVisible="{Binding IsCharging}" />
                                    </Canvas>
                                </Viewbox>

                                <!-- Percentage -->
                                <TextBlock Text="{Binding PercentText}" FontSize="11" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- 4x2 Wide Layout: macOS Horizontal Capsule Bars -->
        <Grid x:Name="WideLayout" RowDefinitions="Auto,*" IsVisible="False" Margin="4,0,4,0">
            <!-- Header Summary -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="电池与外设" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource SystemControlForegroundAccentBrush}" />
                    <TextBlock Text="·" FontSize="11" Opacity="0.4" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SummaryText}" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Device Capsule Bars List -->
            <ScrollViewer Grid.Row="1">
                <ItemsControl ItemsSource="{Binding Devices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:BatteryDeviceItem">
                            <Border Classes="device-bar-card">
                                <Grid ColumnDefinitions="Auto,90,*,Auto" VerticalAlignment="Center">
                                    <!-- Device Icon -->
                                    <PathIcon Grid.Column="0" Data="{Binding IconData}" Width="16" Height="16"
                                              Foreground="{Binding StatusBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />

                                    <!-- Device Name -->
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11" FontWeight="Medium"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                    <!-- Capsule Progress Bar -->
                                    <Grid Grid.Column="2" Margin="6,0,10,0" Height="10" VerticalAlignment="Center">
                                        <!-- Bar Background -->
                                        <Border Background="#20808080" CornerRadius="5" />
                                        <!-- Bar Filled -->
                                        <ProgressBar Value="{Binding Percentage}" Minimum="0" Maximum="100"
                                                     Foreground="{Binding StatusBrush}" Height="10" CornerRadius="5"
                                                     Background="Transparent" BorderThickness="0" />
                                    </Grid>

                                    <!-- Percentage & Charging Icon -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="⚡" FontSize="11" Foreground="#34C759" IsVisible="{Binding IsCharging}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding PercentText}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{Binding StatusBrush}" VerticalAlignment="Center" Width="36" TextAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Panel>
</UserControl>
