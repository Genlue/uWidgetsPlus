<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Music.ViewModels"
             mc:Ignorable="d" d:DesignWidth="160" d:DesignHeight="160"
             Margin="0"
             x:Class="Music.Views.Controls.MusicSmall"
             x:DataType="vm:MusicViewModel">

    <UserControl.Styles>
        <Style Selector="ProgressBar.seek-bar">
            <Setter Property="MinHeight" Value="3.5"/>
            <Setter Property="Height" Value="3.5"/>
            <Setter Property="CornerRadius" Value="1.75"/>
            <Setter Property="Background" Value="#35888888"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="ProgressBarRoot"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True"
                            Height="{TemplateBinding Height}">
                        <Panel>
                            <Border Name="PART_Indicator"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    HorizontalAlignment="Left"/>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.ctrl-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.ctrl-btn:pointerover">
            <Setter Property="Opacity" Value="0.8"/>
        </Style>
    </UserControl.Styles>

    <!-- Strictly bounded inside a 136-wide standard container centered within the card -->
    <Grid Width="136"
          HorizontalAlignment="Center" VerticalAlignment="Center"
          RowDefinitions="Auto,Auto,Auto">
        <!-- Top: Cover Art (Left) + Info (Right) -->
        <Grid Grid.Row="0" ColumnDefinitions="58,*" MinHeight="58">
            <!-- Cover Art Frame -->
            <Border Grid.Column="0" Width="58" Height="58" CornerRadius="12"
                    ClipToBounds="True" Background="#18FFFFFF"
                    VerticalAlignment="Center">
                <Panel>
                    <!-- Fallback Vinyl Disc -->
                    <PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 14.5c-2.49 0-4.5-2.01-4.5-4.5S9.51 7.5 12 7.5s4.5 2.01 4.5 4.5-2.01 4.5-4.5 4.5zm0-5.5c-.55 0-1 .45-1 1s.45 1 1 1 1-.45 1-1-.45-1-1-1z"
                              Width="30" Height="30"
                              Opacity="0.4"
                              Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                              IsVisible="{Binding CoverBitmap, Converter={x:Static ObjectConverters.IsNull}}"/>
                    <!-- Real Album Art -->
                    <Image Source="{Binding CoverBitmap}"
                           Stretch="UniformToFill"
                           IsVisible="{Binding CoverBitmap, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                </Panel>
            </Border>

            <!-- Text & Badge -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0" Spacing="2">
                <!-- App Source Badge -->
                <Border Background="#22888888" CornerRadius="3" Padding="4,1"
                        HorizontalAlignment="Left">
                    <TextBlock Text="{Binding PlayerName}" FontSize="9" FontWeight="SemiBold"
                               Opacity="0.9"
                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </Border>
                <!-- Song Title -->
                <TextBlock Text="{Binding TrackTitle}"
                           FontSize="12" FontWeight="Bold"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                           TextTrimming="CharacterEllipsis" MaxLines="2"/>
                <!-- Artist -->
                <TextBlock Text="{Binding Artist}"
                           FontSize="10" FontWeight="Medium" Opacity="0.88"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                           TextTrimming="CharacterEllipsis" MaxLines="1"/>
            </StackPanel>
        </Grid>

        <!-- Middle: Progress Bar (shifted down for headroom, stretched to align with cover on left and text on right) -->
        <Border Grid.Row="1" Name="ProgressTrack" Height="14" Background="Transparent"
                Cursor="Hand" PointerPressed="OnProgressPointerPressed"
                HorizontalAlignment="Stretch"
                Margin="0,16,0,8"
                IsVisible="{Binding ShowProgressBar}"
                VerticalAlignment="Center">
            <ProgressBar Classes="seek-bar"
                         Minimum="0" Maximum="1" Value="{Binding ProgressPercent}"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Stretch"
                         IsHitTestVisible="False"/>
        </Border>

        <!-- Bottom: Playback Controls (Centered, shifted down) -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center" Margin="0,2,0,0">
            <!-- Previous -->
            <Button Classes="ctrl-btn" Width="26" Height="26" CornerRadius="13"
                    Command="{Binding SkipPrevious}"
                    IsEnabled="{Binding CanSkipPrevious}">
                <PathIcon Data="M6 6h2v12H6zm3.5 6l8.5 6V6z" Width="11" Height="11"
                          Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            </Button>

            <!-- Play / Pause -->
            <Button Classes="ctrl-btn" Width="32" Height="32" CornerRadius="16"
                    Background="#30888888"
                    Command="{Binding TogglePlayPause}"
                    IsEnabled="{Binding CanPlayPause}">
                <Panel>
                    <!-- Play Icon -->
                    <PathIcon Data="M8 5v14l11-7z" Width="13" Height="13"
                              Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                              IsVisible="{Binding !IsPlaying}"/>
                    <!-- Pause Icon -->
                    <PathIcon Data="M6 19h4V5H6v14zm8-14v14h4V5h-4z" Width="13" Height="13"
                              Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                              IsVisible="{Binding IsPlaying}"/>
                </Panel>
            </Button>

            <!-- Next -->
            <Button Classes="ctrl-btn" Width="26" Height="26" CornerRadius="13"
                    Command="{Binding SkipNext}"
                    IsEnabled="{Binding CanSkipNext}">
                <PathIcon Data="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z" Width="11" Height="11"
                          Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
