<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:locales="clr-namespace:Search.Locales"
             xmlns:models="clr-namespace:Search.Models"
             xmlns:services="clr-namespace:Search.Services"
             x:Class="Search.Views.Settings.SearchSettings">

    <UserControl.Styles>
        <Style Selector="Button.small-button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ToolTipBorderBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.small-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
        </Style>
        <Style Selector="Button.icon-button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.icon-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
        </Style>
        <Style Selector="TextBlock.setting-label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>
        <Style Selector="TextBlock.group-header">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,2" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundAccentBrush}" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Orientation="Vertical" Spacing="8" Margin="0,2,16,8">
            <!-- Group 1: General & Behavior -->
            <TextBlock Classes="group-header" Text="常规与搜索行为" />

            <!-- Default Search Engine -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                <TextBlock Classes="setting-label" Text="默认搜索引擎" />
                <ComboBox x:Name="DefaultEngineCombo" Grid.Column="1" Width="150" SelectionChanged="OnDefaultEngineChanged" />
            </Grid>

            <!-- Toggles -->
            <CheckBox x:Name="ClearOnSearchToggle" Content="{x:Static locales:Locale.Search_Clear_On_Search}"
                      IsCheckedChanged="OnToggleChanged" FontSize="13" />

            <CheckBox x:Name="SaveHistoryToggle" Content="{x:Static locales:Locale.Search_Save_History}"
                      IsCheckedChanged="OnToggleChanged" FontSize="13" />

            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                <TextBlock Classes="setting-label" Text="清除所有最近搜索历史" FontSize="12" Opacity="0.7"/>
                <Button Grid.Column="1" Classes="small-button" Content="立即清空" Click="OnClearHistoryClicked" />
            </Grid>

            <!-- Group 2: Engine Management -->
            <TextBlock Classes="group-header" Text="搜索引擎管理" />
            <TextBlock Text="勾选可启用/禁用引擎；列表上方的引擎在界面中拥有更高优先级。"
                       FontSize="11" Opacity="0.65" TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" Margin="0,0,0,4"/>

            <!-- Toolbar -->
            <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Button Classes="small-button" Content="+ 新增自定义引擎"
                        Click="OnShowAddPanelClicked" Margin="0,0,6,4" />
                <Button Classes="small-button" Content="恢复出厂预设"
                        Click="OnResetDefaultsClicked" Margin="0,0,6,4" />
            </WrapPanel>

            <!-- Inline Add / Edit Panel -->
            <Border x:Name="EditPanel" Background="#15888888" CornerRadius="6" Padding="10" Margin="0,0,0,6" IsVisible="False">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="EditPanelTitle" Text="添加自定义搜索引擎" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                    
                    <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                        <TextBlock Classes="setting-label" Text="引擎名称：" FontSize="12" Width="80"/>
                        <TextBox x:Name="EditNameBox" Grid.Column="1" FontSize="12" Watermark="例如：StackOverflow" Height="26" Padding="4,2"/>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                        <TextBlock Classes="setting-label" Text="URL 模板：" FontSize="12" Width="80"/>
                        <TextBox x:Name="EditUrlBox" Grid.Column="1" FontSize="12" Watermark="例如：https://stackoverflow.com/search?q={q}" Height="26" Padding="4,2"/>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                        <TextBlock Classes="setting-label" Text="所属分类：" FontSize="12" Width="80"/>
                        <ComboBox x:Name="EditCategoryCombo" Grid.Column="1" HorizontalAlignment="Stretch"/>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                        <TextBlock Classes="setting-label" Text="内置图标：" FontSize="12" Width="80"/>
                        <ComboBox x:Name="EditIconCombo" Grid.Column="1" HorizontalAlignment="Stretch"/>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                        <TextBlock Classes="setting-label" Text="品牌颜色：" FontSize="12" Width="80"/>
                        <TextBox x:Name="EditColorBox" Grid.Column="1" FontSize="12" Watermark="#4285F4" Height="26" Padding="4,2"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,4,0,0">
                        <Button Classes="small-button" Content="取消" Click="OnCancelEdit" />
                        <Button Classes="small-button" Content="保存" Click="OnConfirmEdit" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Engines List -->
            <ItemsControl x:Name="EnginesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:SearchEngine">
                        <Border Background="#0C888888" CornerRadius="6" Padding="6,4" Margin="0,2">
                            <Grid ColumnDefinitions="Auto, Auto, *, Auto">
                                <!-- Enable Checkbox -->
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                          Click="OnEngineCheckboxClicked"
                                          VerticalAlignment="Center" Margin="0,0,4,0"/>

                                <!-- Icon & Name -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <PathIcon Data="{Binding SvgPath}"
                                              Foreground="{Binding IconColor}"
                                              Width="16" Height="16"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <!-- Category badge -->
                                    <Border Background="#18808080" CornerRadius="4" Padding="4,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Category}" FontSize="10" Opacity="0.7"/>
                                    </Border>
                                </StackPanel>

                                <!-- URL template snippet -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding UrlTemplate}"
                                           FontSize="10"
                                           Opacity="0.5"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           Margin="10,0,6,0"/>

                                <!-- Action Buttons: Up, Down, Edit, Delete -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                    <Button Classes="icon-button" Click="OnMoveUpClicked" Tag="{Binding}" ToolTip.Tip="上移">
                                        <TextBlock Text="▲" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Classes="icon-button" Click="OnMoveDownClicked" Tag="{Binding}" ToolTip.Tip="下移">
                                        <TextBlock Text="▼" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Classes="icon-button" Click="OnEditEngineClicked" Tag="{Binding}" ToolTip.Tip="编辑">
                                        <TextBlock Text="✎" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Classes="icon-button" Click="OnDeleteEngineClicked" Tag="{Binding}" ToolTip.Tip="删除">
                                        <TextBlock Text="✕" FontSize="11" Foreground="#E05555" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
