<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:locales="clr-namespace:Tools.Locales"
             x:Class="Tools.Views.Settings.TranslatorSettings">
    <UserControl.Styles>
        <Style Selector="TextBlock.setting-label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>
        <Style Selector="TextBlock.setting-desc">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>
        <Style Selector="TextBlock.group-header">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundAccentBrush}" />
        </Style>
        <Style Selector="TextBox.setting-input">
            <Setter Property="Background" Value="#15808080" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#25ffffff" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>
        <Style Selector="ComboBox.setting-combo">
            <Setter Property="Width" Value="160" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Orientation="Vertical" Spacing="10" Margin="0,2,16,8">
            <TextBlock Classes="group-header" Text="常规翻译设置" />

            <!-- Default Engine -->
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <TextBlock Classes="setting-label" Text="{x:Static locales:Locale.Tools_Translator_Engine}" />
                <TextBlock Grid.Row="1" Classes="setting-desc" Text="{x:Static locales:Locale.Tools_Translator_Engine_Desc}" />
                <ComboBox x:Name="DefaultEngineCombo" Grid.Column="1" Grid.RowSpan="2" Classes="setting-combo"
                          SelectionChanged="OnEngineSelectionChanged" />
            </Grid>

            <!-- Auto Translate As You Type -->
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <TextBlock Classes="setting-label" Text="{x:Static locales:Locale.Tools_Translator_AutoTranslate}" />
                <TextBlock Grid.Row="1" Classes="setting-desc" Text="{x:Static locales:Locale.Tools_Translator_AutoTranslate_Desc}" />
                <ToggleSwitch x:Name="AutoTranslateToggle" Grid.Column="1" Grid.RowSpan="2" OnContent="" OffContent=""
                              IsCheckedChanged="OnToggleChanged" />
            </Grid>

            <TextBlock Classes="group-header" Text="百度翻译开放平台设置 (可选)" />

            <!-- Baidu AppId -->
            <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                <TextBlock Classes="setting-label" Text="{x:Static locales:Locale.Tools_Translator_BaiduAppId}" Width="130" />
                <TextBox x:Name="BaiduAppIdBox" Grid.Column="1" Classes="setting-input" Watermark="填入百度翻译开放平台 AppID"
                         TextChanged="OnBaiduCredentialsChanged" />
            </Grid>

            <!-- Baidu Secret -->
            <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                <TextBlock Classes="setting-label" Text="{x:Static locales:Locale.Tools_Translator_BaiduSecret}" Width="130" />
                <TextBox x:Name="BaiduSecretBox" Grid.Column="1" Classes="setting-input" PasswordChar="•" Watermark="填入密钥 SecretKey"
                         TextChanged="OnBaiduCredentialsChanged" />
            </Grid>

            <TextBlock Classes="group-header" Text="自定义 / DeepLX 接口设置 (可选)" />

            <!-- Custom URL -->
            <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                <TextBlock Classes="setting-label" Text="{x:Static locales:Locale.Tools_Translator_CustomUrl}" Width="130" />
                <TextBox x:Name="CustomUrlBox" Grid.Column="1" Classes="setting-input" Watermark="例如 http://127.0.0.1:1188/translate"
                         TextChanged="OnCustomUrlChanged" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
