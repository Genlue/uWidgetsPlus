<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      Liquid glass material: same neutral resources as Transparent.axaml, but the
      window does NOT use Avalonia's own AcrylicBlur — the Windows 11 system
      gradient-blur backdrop (applied by InteropService.SetLiquidGlassBackdrop)
      renders the glass instead. Mica keeps the window per-pixel transparent so
      the system backdrop shows through the semi-transparent card.
    -->
    <Style>
        <Style.Resources>
            <SolidColorBrush x:Key="WidgetBackground" Color="{DynamicResource SystemAltHighColor}" Opacity="{DynamicResource BackgroundOpacity}" />
            <SolidColorBrush x:Key="SettingsBackground" Color="{DynamicResource SystemChromeLowColor}" Opacity="0.9" />
            <x:Double x:Key="TextOpacity">0.8</x:Double>
        </Style.Resources>
    </Style>
    <Style Selector="Window">
        <Setter Property="TransparencyLevelHint" Value="Mica" />
    </Style>
    <Style Selector="TextBlock">
        <Setter Property="Opacity" Value="0.8" />
    </Style>
</Styles>
