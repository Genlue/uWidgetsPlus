<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:uWidgets.Views.Pages"
             xmlns:viewModels="clr-namespace:uWidgets.ViewModels"
             x:Class="uWidgets.Views.Pages.Gallery"
             x:DataType="pages:Gallery">
    <UserControl.Styles>
        <Style Selector="Button.gallery-card">
            <Setter Property="CornerRadius" Value="{Binding Radius, RelativeSource={RelativeSource AncestorType=pages:Gallery}}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Background" Value="#18808080" />
            <Setter Property="BorderBrush" Value="#22ffffff" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.gallery-card:pointerover">
            <Setter Property="Background" Value="#28808080" />
            <Setter Property="BorderBrush" Value="#45ffffff" />
        </Style>
        <Style Selector="Button.gallery-card > Border">
            <Setter Property="CornerRadius" Value="{Binding Radius, RelativeSource={RelativeSource AncestorType=pages:Gallery}}" />
        </Style>
    </UserControl.Styles>
    <StackPanel Margin="0,0,0,32">
        <ItemsControl ItemsSource="{Binding Widgets}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="viewModels:WidgetPreviewViewModel">
                    <StackPanel Width="{Binding CardWidth}" Margin="12,0,12,32">
                        <Button Classes="gallery-card"
                                Width="{Binding PreviewWidth}"
                                Height="{Binding PreviewHeight}"
                                HorizontalAlignment="Center"
                                VerticalContentAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                ToolTip.Tip="点击添加到桌面"
                                Click="Button_OnClick">
                            <Border ClipToBounds="True" Background="Transparent">
                                <ContentPresenter IsHitTestVisible="False" Content="{Binding Control}" Margin="10" />
                            </Border>
                        </Button>
                        <TextBlock Margin="0,14,0,4" FontWeight="SemiBold" FontSize="13.5" TextAlignment="Center" Text="{Binding Title}" />
                        <TextBlock TextAlignment="Center" FontSize="11.5" Opacity="0.6" TextWrapping="Wrap" Text="{Binding Subtitle}" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </StackPanel>
</UserControl>
