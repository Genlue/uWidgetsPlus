<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:locales="clr-namespace:uWidgets.Locales"
        xmlns:views="clr-namespace:uWidgets.Views"
        x:Class="uWidgets.Views.Widget"
        Background="Transparent"
        ShowInTaskbar="False"
        ToolTip.Placement="BottomEdgeAlignedRight"
        ToolTip.VerticalOffset="-25"
        ToolTip.HorizontalOffset="7"
        SystemDecorations="{Binding WidgetSystemDecorations}"
        ExtendClientAreaToDecorationsHint="{Binding WidgetExtendClientArea}"
        ExtendClientAreaTitleBarHeightHint="0"
        CanResize="False"
        x:DataType="views:Widget"
        Classes="Widget">

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="{Binding Edit}" Command="{Binding EditWidget}" IsVisible="{Binding ShowEditButton}" />
            <Separator IsVisible="{Binding ShowEditButton}"/>
            <MenuItem Header="{Binding SizeMenuTitle}">
                <MenuItem Header="1×1"  Command="{Binding ResizeSize}" CommandParameter="1,1"  />
                <MenuItem Header="1×2"  Command="{Binding ResizeSize}" CommandParameter="1,2"  />
                <MenuItem Header="1×3"  Command="{Binding ResizeSize}" CommandParameter="1,3"  />
                <MenuItem Header="1×4"  Command="{Binding ResizeSize}" CommandParameter="1,4"  />
                <MenuItem Header="2×1"  Command="{Binding ResizeSize}" CommandParameter="2,1"  />
                <MenuItem Header="2×2"  Command="{Binding ResizeSize}" CommandParameter="2,2"  />
                <MenuItem Header="2×3"  Command="{Binding ResizeSize}" CommandParameter="2,3"  />
                <MenuItem Header="2×4"  Command="{Binding ResizeSize}" CommandParameter="2,4"  />
                <MenuItem Header="3×1"  Command="{Binding ResizeSize}" CommandParameter="3,1"  />
                <MenuItem Header="3×2"  Command="{Binding ResizeSize}" CommandParameter="3,2"  />
                <MenuItem Header="3×3"  Command="{Binding ResizeSize}" CommandParameter="3,3"  />
                <MenuItem Header="3×4"  Command="{Binding ResizeSize}" CommandParameter="3,4"  />
                <MenuItem Header="4×1"  Command="{Binding ResizeSize}" CommandParameter="4,1"  />
                <MenuItem Header="4×2"  Command="{Binding ResizeSize}" CommandParameter="4,2"  />
                <MenuItem Header="4×3"  Command="{Binding ResizeSize}" CommandParameter="4,3"  />
                <MenuItem Header="4×4"  Command="{Binding ResizeSize}" CommandParameter="4,4"  />
            </MenuItem>
            <Separator />
            <MenuItem Header="{x:Static locales:Locale.Widget_Remove}" Command="{Binding Remove}" />
            <Separator />
            <MenuItem Header="{x:Static locales:Locale.Settings}" Command="{Binding OpenSettings}" />
        </ContextMenu>
    </Window.ContextMenu> 
    
    <Window.Styles>
        <Style Selector="Border:not(:pointerover) ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
        </Style>
        <Style Selector="Border:pointerover ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style Selector=":is(UserControl)">
            <Setter Property="Margin" Value="12" />
        </Style>
        <Style Selector="ToolTip">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Window.Styles>
    
    <ToolTip.Tip>
        <Viewbox IsVisible="{Binding ToolTipVisible}" Stretch="Uniform" Width="32" Height="32">
            <Path Fill="{DynamicResource SystemControlForegroundBaseHighBrush}" 
                  Data="M1 3A1 1 0 001 5C3 5 5 3 5 1A1 1 0 003 1C3 2 2 3 1 3"
                  PointerPressed="Resize"/>
        </Viewbox>
    </ToolTip.Tip>
    
    <Grid>
        <!-- Card (frosted glass): fills the grid cell minus the configured margin,
             with the configured corner radius. The native window region is clipped
             to the same rectangle (see ApplyWidgetRegion) so the OS-level acrylic
             blur follows the card instead of covering the whole grid cell. -->
        <Border Name="Border"
                CornerRadius="{Binding Radius, RelativeSource={RelativeSource AncestorType=views:Widget}}"
                Background="{DynamicResource WidgetBackground}"
                Margin="{Binding WidgetMargin, RelativeSource={RelativeSource AncestorType=views:Widget}}"
                ClipToBounds="True">
            <!-- Content: sized by the card only; the content scale (Scale()) is a
                 render transform on this presenter, so it never resizes the card. -->
            <ContentPresenter Name="ContentPresenter"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                <ContentPresenter.ContentTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding}" />
                    </DataTemplate>
                </ContentPresenter.ContentTemplate>
            </ContentPresenter>
        </Border>
    </Grid>
    
</Window>
